{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zzzwannasleep.github.io/LinplayerPluginsRepository/schemas/manifest.schema.json",
  "title": "LinPlayer 插件清单 (apiVersion 2)",
  "description": "编辑器补全用。真正的校验闸门是 tools/validate_repo.py（带自检），规则源头是宿主 crates/core/src/plugins/manifest.rs。",
  "type": "object",
  "required": ["id", "version", "apiVersion", "name", "description"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$",
      "description": "反向域名，如 com.example.myplugin。必须和目录名一致。"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
      "description": "语义化版本 x.y.z。必须和版本目录名一致。"
    },
    "apiVersion": {
      "const": 2,
      "description": "插件 API 版本。必须是 2 —— 缺省会被宿主视为 v1 并拒绝安装。"
    },
    "name": { "type": "string", "minLength": 1, "description": "展示名称。" },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "一句话说明这个插件干什么。市场卡片直接显示。"
    },
    "author": {
      "type": "string",
      "description": "作者名。必须是字符串 —— v1 的 {\"name\": …} 对象形式会让宿主整条跳过。"
    },
    "category": {
      "enum": ["source", "ui", "player", "notify", "tools"],
      "description": "市场分类。缺省 tools。"
    },
    "targets": {
      "type": "array",
      "items": { "enum": ["pc", "mobile", "tv"] },
      "description": "适配端。空或省略 = 不限。（没有 ios，苹果全线不做。）"
    },
    "main": { "type": "string", "default": "main.js", "description": "入口 JS，相对插件目录。" },
    "icon": {
      "type": "string",
      "description": "图标文件名（svg/png，≤64KB）。构建时会内联进 registry.json。"
    },
    "homepage": { "type": "string" },
    "license": { "type": "string" },
    "minAppVersion": { "type": "string", "description": "要求的最低 LinPlayer 版本。" },
    "tags": { "type": "array", "items": { "type": "string" } },

    "permissions": {
      "type": "array",
      "description": "声明所需能力。用户在启用前会看到逐条人话说明。log 隐式授予、无需声明。",
      "items": {
        "enum": [
          "player.read",
          "player.control",
          "http",
          "storage",
          "ui",
          "emby.read",
          "emby.api",
          "sources",
          "extensions",
          "sandbox",
          "log"
        ]
      }
    },

    "httpAllowedHosts": {
      "type": "array",
      "description": "出网白名单。空 = 拒绝一切出网（fail-closed）。支持 *.example.com 子域通配；裸 * 无效。特殊令牌 $sourceServer 展开成用户在「添加服务器」亲手填的地址，也是唯一允许明文 http 的路径。",
      "items": { "type": "string" }
    },

    "contributes": {
      "type": "object",
      "description": "把能力挂到宿主的预定义位置。每一类都要求声明对应权限。",
      "additionalProperties": false,
      "properties": {
        "dataSources": {
          "description": "贡献一个完整数据源（需 sources 权限）。运行时用 ctx.sources.register 补上三个回调。",
          "type": ["array", "object"],
          "items": { "$ref": "#/$defs/dataSource" }
        },
        "panels": {
          "description": "贡献一块界面，挂在 slot 指定的位置（需 extensions 权限）。",
          "type": ["array", "object"],
          "items": { "$ref": "#/$defs/panel" }
        },
        "actions": {
          "description": "贡献一个操作项（需 extensions 权限）。",
          "type": ["array", "object"],
          "items": { "$ref": "#/$defs/action" }
        },
        "sandboxViews": {
          "description": "贡献一个 iframe 逃生舱视图（需 sandbox 权限）。",
          "type": ["array", "object"],
          "items": { "$ref": "#/$defs/sandboxView" }
        }
      }
    }
  },

  "not": {
    "anyOf": [
      { "required": ["extends"] },
      { "required": ["runtime"] },
      { "required": ["data"] },
      { "required": ["addon"] },
      { "required": ["channel"] },
      { "required": ["minHostVersion"] }
    ]
  },

  "$defs": {
    "dataSource": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "description": "展示名。「添加服务器」页上显示的就是它。" },
        "auth": {
          "type": "object",
          "description": "登录表单。宿主按这个描述渲染，插件不用自己画。",
          "required": ["fields"],
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "label": { "type": "string" },
                  "type": { "enum": ["text", "password", "url", "number"] },
                  "required": { "type": "boolean" },
                  "placeholder": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "required": ["id", "slot"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "slot": { "enum": ["home.stats", "sidebar", "settings", "player.overlay", "page"] },
        "handler": { "type": "string", "description": "全局函数名，返回一棵声明式 UI 描述树。" },
        "icon": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "context": { "enum": ["global", "item", "player"], "default": "global" },
        "handler": { "type": "string" }
      }
    },
    "sandboxView": {
      "type": "object",
      "required": ["id", "entry"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "插件目录内的 html 相对路径。不许 .. 或绝对路径。"
        }
      }
    }
  }
}
