{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linplayer.dev/schemas/manifest.schema.json",
  "title": "LinPlayer Plugin Manifest",
  "description": "manifest.json 的格式，与 App 内置插件加载器（lib/plugins）一致。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "description", "permissions"],
  "properties": {
    "id": {
      "type": "string",
      "description": "反向域名唯一标识，至少包含一个点。",
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$",
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "description": "语义化版本 major.minor.patch。",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "main": {
      "type": "string",
      "description": "入口 JS 文件名，默认 main.js。",
      "maxLength": 200
    },
    "icon": { "type": "string", "maxLength": 200 },
    "homepage": { "type": "string", "maxLength": 300 },
    "minAppVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 30 },
      "maxItems": 30,
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "description": "市场筛选用：该插件适配的端。注意：ios 端受 App Store 政策限制，不能执行下载来的 main.js，iOS 专用插件须为数据驱动/声明式形态（非可执行 JS）。",
      "items": { "type": "string", "enum": ["tv", "mobile", "pc", "ios"] },
      "uniqueItems": true
    },
    "channel": { "type": "string", "enum": ["stable", "beta", "dev"] },
    "apiVersion": { "type": "integer", "minimum": 1 },
    "minHostVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "license": { "type": "string", "maxLength": 80 },
    "permissions": {
      "type": "array",
      "description": "申请的能力，启用前需用户同意。",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "player.read",
          "player.control",
          "http",
          "storage",
          "ui",
          "emby.read",
          "emby.api",
          "emby.credentials",
          "extensions",
          "cfproxy",
          "log"
        ]
      }
    },
    "httpAllowedHosts": {
      "type": "array",
      "description": "HTTPS 域名白名单（空=不限 host，但仍强制 HTTPS）。",
      "items": { "type": "string", "minLength": 1, "maxLength": 255 },
      "maxItems": 200
    },
    "extends": {
      "type": "object",
      "description": "静态声明的扩展点。",
      "additionalProperties": false,
      "properties": {
        "sidebarItems": { "$ref": "#/$defs/extList" },
        "mediaSources": { "$ref": "#/$defs/extList" },
        "actions": { "$ref": "#/$defs/extList" },
        "eventListeners": { "$ref": "#/$defs/extList" },
        "settingsPages": { "$ref": "#/$defs/extList" },
        "playerOverlays": { "$ref": "#/$defs/extList" },
        "contextMenus": { "$ref": "#/$defs/extList" },
        "homeStats": { "$ref": "#/$defs/extList" }
      }
    },
    "runtime": {
      "type": "string",
      "description": "插件运行时形态。js=可执行 JS(main.js，默认，桌面/安卓/TV)；data=声明式数据驱动(App 内置解释器执行，iOS 合规)；addon=远程 addon 服务(App 按协议收发 JSON，iOS 合规)。凡 targets 含 ios 必须为 data 或 addon。",
      "enum": ["js", "data", "addon"],
      "default": "js"
    },
    "data": {
      "type": "object",
      "description": "runtime=data 时的声明式规则(无可执行代码)。模板插值支持 {serverUrl} {cfg.KEY} {media.FIELD}；path 为响应 JSON 的点路径。",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "type": "array",
          "description": "用户可填配置，值以 {cfg.KEY} 引用。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "maxLength": 60 },
              "label": { "type": "string", "maxLength": 80 },
              "type": { "type": "string", "enum": ["text", "password", "number", "switch"] },
              "default": {},
              "hint": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "homeStats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "metrics"],
          "properties": {
            "when": { "$ref": "#/$defs/whenGate" },
            "request": { "$ref": "#/$defs/dataRequest" },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "path"],
                "properties": {
                  "label": { "type": "string", "maxLength": 80 },
                  "path": { "type": "string", "maxLength": 200 },
                  "suffix": { "type": "string", "maxLength": 20 }
                }
              }
            }
          }
        },
        "onEvent": {
          "type": "array",
          "description": "播放事件触发的请求(如播完发通知)。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "request"],
            "properties": {
              "event": { "type": "string", "enum": ["onPlay", "onPause", "onPlayEnd"] },
              "request": { "$ref": "#/$defs/dataRequest" }
            }
          }
        },
        "mediaSource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "maxLength": 80 },
            "catalog": { "$ref": "#/$defs/dataList" },
            "search": { "$ref": "#/$defs/dataList" }
          }
        }
      }
    },
    "addon": {
      "type": "object",
      "description": "runtime=addon 时的远程服务描述。App 请求 {baseUrl}/manifest.json 与各 resource 端点，逻辑在服务端执行。",
      "additionalProperties": false,
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": { "type": "string", "pattern": "^https://", "maxLength": 300 },
        "resources": {
          "type": "array",
          "items": { "type": "string", "enum": ["catalog", "meta", "stream", "homeStats"] },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "whenGate": {
      "type": "object",
      "description": "触发门槛，全部满足才生效。",
      "additionalProperties": false,
      "properties": {
        "serverUrlIncludes": { "type": "string", "maxLength": 200 }
      }
    },
    "dataRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "url": { "type": "string", "maxLength": 500, "description": "HTTPS，支持模板插值" },
        "auth": { "type": "string", "enum": ["none", "emby"], "description": "emby=以当前登录身份注入 Emby 鉴权" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "query": { "type": "object", "additionalProperties": { "type": "string" } },
        "json": { "description": "POST 的 JSON 体(值支持模板插值)" }
      }
    },
    "dataList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "list", "map"],
      "properties": {
        "request": { "$ref": "#/$defs/dataRequest" },
        "list": { "type": "string", "maxLength": 200, "description": "响应中列表所在的点路径" },
        "map": {
          "type": "object",
          "description": "列表项字段映射：目标字段 -> 源点路径",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "extList": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "description": "扩展点描述，字段随类型而定（常见：id/title/icon/handler/route）。",
        "properties": {
          "id": { "type": "string", "maxLength": 80 },
          "title": { "type": "string", "maxLength": 80 },
          "icon": { "type": "string", "maxLength": 200 },
          "handler": { "type": "string", "maxLength": 120 },
          "route": { "type": "string", "maxLength": 200 }
        },
        "additionalProperties": true
      }
    }
  }
}
