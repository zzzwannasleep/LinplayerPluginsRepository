{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/registry.schema.json",
  "title": "Plugin Registry (schemaVersion=1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "plugins"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/pluginEntry" }
    }
  },
  "$defs": {
    "pluginEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "targets", "versions"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 80 },
            "homepage": { "type": "string", "format": "uri" }
          }
        },
        "homepage": { "type": "string", "format": "uri" },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 30 }, "uniqueItems": true, "maxItems": 30 },
        "targets": { "type": "array", "items": { "type": "string", "enum": ["tv", "mobile", "pc"] }, "uniqueItems": true, "minItems": 1 },
        "iconUrl": { "type": "string", "format": "uri" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/versionEntry" }
        }
      }
    },
    "versionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "apiVersion", "minHostVersion", "manifestUrl"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "channel": { "type": "string", "enum": ["stable", "beta", "dev"] },
        "apiVersion": { "type": "integer", "minimum": 1 },
        "minHostVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "manifestUrl": { "type": "string", "format": "uri" },
        "packageUrl": { "type": "string", "format": "uri" }
      }
    }
  }
}

