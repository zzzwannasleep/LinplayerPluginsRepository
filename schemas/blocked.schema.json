{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/blocked.schema.json",
  "title": "Blocked List (schemaVersion=1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "blockedPlugins", "blockedVersions"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "message": { "type": "string", "maxLength": 5000 },
    "blockedPlugins": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/blockedPlugin" }
    },
    "blockedVersions": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/blockedVersion" }
    }
  },
  "$defs": {
    "blockedPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 200 },
        "reason": { "type": "string", "maxLength": 500 }
      }
    },
    "blockedVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "reason": { "type": "string", "maxLength": 500 }
      }
    }
  }
}

