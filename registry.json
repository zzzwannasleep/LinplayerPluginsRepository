          {
            "id": "account",
            "title": "UHDNow 账号",
            "slot": "settings",
            "handler": "renderAccount",
            "save": "saveAccount"
          }
        ]
      },
      "homepage": "https://www.uhdnow.com/user"
    },
    {
      "id": "com.linplayer.ui-kit",
      "name": "界面块速查",
      "description": "把声明式界面能用的每一种块都画一遍，旁边贴上对应的 JSON。写插件时开着它照抄。",
