{
  "schemaVersion": 2,
  "plugins": [
    {
      "id": "com.linplayer.hello",
      "name": "Hello 示例",
      "description": "最小教学插件：首页显示一句问候，设置里可以改称呼。想写插件，从抄它开始。",
      "author": "LinPlayer",
      "category": "tools",
      "tags": [
        "示例",
        "入门",
        "教程"
      ],
      "targets": [
        "pc"
      ],
      "permissions": [
        "ui",
        "storage",
        "extensions"
      ],
      "versions": [
        {
          "version": "2.0.0",
          "api_version": 2,
          "package_url": "https://raw.githubusercontent.com/zzzwannasleep/LinplayerPluginsRepository/main/packages/com.linplayer.hello-2.0.0.ipk",
          "sha256": "2c9528cf41533ccf6a9be1536c32cd98cea9ea7146383bf4944d055f1fa0a503"
        }
      ],
      "icon": "data:image/svg+xml;base64,",
      "contributes": {
        "panels": [
          {
            "id": "greeting",
            "title": "问候",
            "slot": "home.stats",
            "handler": "renderGreeting"
          },
          {
            "id": "settings",
            "title": "Hello 设置",
            "slot": "settings",
            "handler": "renderSettings",
            "save": "saveSettings"
          }
        ]
      },
      "homepage": "https://github.com/zzzwannasleep/LinplayerPluginsRepository"
    },
    {
      "id": "com.linplayer.m3u",
      "name": "M3U 直播源",
      "description": "填一个 m3u / m3u8 播放列表地址，按分组浏览频道并直接播放。支持搜索、台标、EPG 分组。",
      "author": "LinPlayer",
      "category": "source",
      "tags": [
        "直播",
        "iptv",
        "m3u",
        "数据源"
      ],
      "targets": [
        "pc"
      ],
      "permissions": [
        "sources",
        "http",
        "storage"
      ],
      "versions": [
        {
          "version": "1.0.0",
          "api_version": 2,
          "package_url": "https://raw.githubusercontent.com/zzzwannasleep/LinplayerPluginsRepository/main/packages/com.linplayer.m3u-1.0.0.ipk",
          "sha256": "c12580b8f973f9247e4027d323316c028fdce9398eaf88e2295f98175fb902d8"
        }
      ],
      "icon": "data:image/svg+xml;base64,",
      "contributes": {
        "dataSources": [
          {
            "id": "playlist",
            "name": "M3U 直播源",
            "auth": {
              "fields": [
                {
                  "id": "base_url",
                  "label": "播放列表地址",
                  "type": "url",
                  "required": true,
                  "placeholder": "https://example.com/iptv.m3u"
                }
              ]
            }
          }
        ]
      },
      "homepage": "https://github.com/zzzwannasleep/LinplayerPluginsRepository"
    },
    {
      "id": "com.linplayer.sandbox-demo",
      "name": "沙箱界面示例",
      "description": "声明式界面画不出来的东西，用自带网页画。演示 iframe 逃生舱：插件自己的 HTML/CSS/JS，跑在隔离沙箱里。",
      "author": "LinPlayer",
      "category": "ui",
      "tags": [
        "示例",
        "沙箱",
        "iframe",
        "自定义界面"
      ],
      "targets": [
        "pc"
      ],
      "permissions": [
        "sandbox"
      ],
      "versions": [
        {
          "version": "1.0.0",
          "api_version": 2,
          "package_url": "https://raw.githubusercontent.com/zzzwannasleep/LinplayerPluginsRepository/main/packages/com.linplayer.sandbox-demo-1.0.0.ipk",
          "sha256": "7acc545b0e4e2fde2f90656ea3b3daa642498240b80bd6ee979658aa04ef20e1"
        }
      ],
      "icon": "data:image/svg+xml;base64,",
      "contributes": {
        "sandboxViews": [
          {
            "id": "chart",
            "title": "自绘图表",
            "entry": "view/index.html"
          }
        ]
      },
      "homepage": "https://github.com/zzzwannasleep/LinplayerPluginsRepository"
    },
    {
      "id": "com.linplayer.telegram-notify",
      "name": "Telegram 播放通知",
      "description": "每看完一集，自动用你的 Telegram Bot 发一条消息。填个 Bot Token 和 Chat ID 就能用。",
      "author": "LinPlayer",
      "category": "notify",
      "tags": [
        "通知",
        "telegram",
        "播放"
      ],
      "targets": [
        "pc"
      ],
      "permissions": [
        "player.read",
        "http",
        "storage",
        "ui",
        "extensions"
      ],
      "versions": [
        {
          "version": "2.0.0",
          "api_version": 2,
          "package_url": "https://raw.githubusercontent.com/zzzwannasleep/LinplayerPluginsRepository/main/packages/com.linplayer.telegram-notify-2.0.0.ipk",
          "sha256": "7bdb8bc77d7e63e7580dfbc58998c4216c08788da76f451f39bbab2bf7b1b9a0"
        }
      ],
      "icon": "data:image/svg+xml;base64,",
      "contributes": {
        "panels": [
          {
            "id": "settings",
            "title": "Telegram 通知",
            "slot": "settings",
            "handler": "renderSettings",
            "save": "saveSettings",
            "test": "sendTest"
          }
        ]
      },
      "homepage": "https://github.com/zzzwannasleep/LinplayerPluginsRepository"
    },
    {
      "id": "com.linplayer.uhdnow",
      "name": "UHDNow 助手",
      "description": "UHDNow 用户的三合一工具：首页看剩余流量、在 App 里求片/追新/投票、给线路测速。账号只需填一次。",
      "author": "LinPlayer",
      "category": "tools",
      "tags": [
        "uhdnow",
        "求片",
        "测速",
        "流量"
      ],
      "targets": [
        "pc"
      ],
      "permissions": [
        "http",
        "storage",
        "ui",
        "extensions",
        "emby.read"
      ],
      "versions": [
        {
          "version": "1.0.0",
          "api_version": 2,
          "package_url": "https://raw.githubusercontent.com/zzzwannasleep/LinplayerPluginsRepository/main/packages/com.linplayer.uhdnow-1.0.0.ipk",
          "sha256": "0c7f888549a5b9faedaf0ac2977c77133a18cabe049e8259bc0120376208d1cb"
        }
      ],
      "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA2NCA2NCIgd2lkdGg9IjY0IiBoZWlnaHQ9IjY0Ij4KICA8cmVjdCB3aWR0aD0iNjQiIGhlaWdodD0iNjQiIHJ4PSIxNCIgZmlsbD0iIzFmMjkzNyIvPgogIDxwYXRoIGQ9Ik0zNCAxMkwxOCAzNmgxMmwtNCAxNiAxOC0yNkgzMnoiIGZpbGw9IiNmZmQxNjYiLz4KPC9zdmc+Cg==",
      "contributes": {
        "panels": [
          {
            "id": "traffic",
            "title": "UHDNow 流量",
            "slot": "home.stats",
            "handler": "renderTraffic"
          },
          {
            "id": "hub",
            "title": "UHDNow 助手",
            "slot": "sidebar",
            "icon": "bolt",
