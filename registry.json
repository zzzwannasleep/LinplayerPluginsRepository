        "示例",
        "界面",
        "速查"
      ],
      "targets": [
        "pc"
      ],
      "permissions": [
        "ui",
        "extensions"
      ],
      "versions": [
        {
          "version": "1.0.0",
          "api_version": 2,
          "package_url": "https://raw.githubusercontent.com/zzzwannasleep/LinplayerPluginsRepository/main/packages/com.linplayer.ui-kit-1.0.0.ipk",
          "sha256": "4ae086ce476b1d28e1dd5d18b0d13a0af9cce60ce2a1d0292cdacbf7178a8650"
        }
      ],
