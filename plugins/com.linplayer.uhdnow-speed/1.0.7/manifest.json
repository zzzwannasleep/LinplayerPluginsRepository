{
  "id": "com.linplayer.uhdnow-speed",
  "version": "1.0.7",
  "name": "UHDNow 线路测速",
  "author": "LinPlayer",
  "description": "从线路列表里选一条 UHDNow 线路测下载速度，全程进度可视化。测试大小对标官网 32/64/100 MiB。需登录网站账号，会消耗账户流量。",
  "main": "main.js",
  "homepage": "https://www.uhdnow.com/speed",
  "tags": [
    "uhdnow",
    "speed",
    "测速",
    "network"
  ],
  "targets": [
    "pc",
    "mobile",
    "tv"
  ],
  "channel": "stable",
  "apiVersion": 1,
  "minHostVersion": "1.0.0",
  "permissions": [
    "emby.read",
    "emby.credentials",
    "http",
    "storage",
    "ui",
    "extensions"
  ],
  "httpAllowedHosts": [
    "www.uhdnow.com",
    "uhdnow.com",
    "speed.uhdnow.com",
    "uhdnow.online",
    "*.uhdnow.com",
    "*.uhdnow.online"
  ],
  "extends": {
    "settingsPages": [
      {
        "id": "speedtest",
        "title": "开始测速",
        "handler": "openSpeedTest"
      },
      {
        "id": "account",
        "title": "账号设置",
        "handler": "openAccount"
      }
    ]
  }
}