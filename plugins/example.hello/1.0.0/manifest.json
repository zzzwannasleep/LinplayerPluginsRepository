                                                    ]
                                    }
                    },
    "files":  [
                  {
                      "path":  "main.js",
                      "size":  4778,
                      "sha256":  "7a2de58f10a49410967c283dfae8a53518488f8462604c1b9b260ed1ee122f93"
                  }
              ],
    "contributions":  {
                          "pages":  [
                                        {
                                            "id":  "home",
                                            "title":  "Open Website Example",
                                            "route":  "/plugin/example.hello/home",
                                            "targets":  [
                                                            "mobile",
                                                            "pc"
                                                        ],
                                            "render":  "page_home_render",
