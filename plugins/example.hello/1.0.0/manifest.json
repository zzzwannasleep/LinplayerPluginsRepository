{
    "schemaVersion":  1,
    "id":  "example.hello",
    "name":  "Hello Plugin",
    "description":  "演示：页面 + 事件 + 网络请求（通过 ctx.net.request）",
    "version":  "1.0.0",
    "apiVersion":  1,
    "minHostVersion":  "0.0.1",
    "author":  {
                   "name":  "Example"
               },
    "targets":  [
                    "tv",
                    "mobile",
                    "pc"
                ],
    "entry":  {
                  "tv":  {
                             "script":  "main.js"
                         },
                  "mobile":  {
                                 "script":  "main.js"
                             },
                  "pc":  {
                             "script":  "main.js"
                         }
              },
    "permissions":  {
                        "network":  {
                                        "enabled":  true,
                                        "domains":  [
                                                        "*"
                                                    ]
                                    }
                    },
    "files":  [
                  {
                      "path":  "main.js",
                      "size":  5914,
                      "sha256":  "4f302a04c8aad6885dcd37e9feabbfdde7017e841d1793e134042a1f72b9ef62"
                  }
              ],
    "contributions":  {
                          "pages":  [
                                        {
                                            "id":  "home",
                                            "title":  "Hello Plugin",
                                            "route":  "/plugin/example.hello/home",
                                            "targets":  [
                                                            "tv",
                                                            "mobile",
                                                            "pc"
                                                        ],
                                            "render":  "page_home_render",
                                            "onEvent":  "page_home_onEvent",
                                            "order":  0,
                                            "entry":  true
                                        }
                                    ],
                          "slots":  [
                                        {
                                            "id":  "hello_home",
                                            "title":  "Home Hello",
                                            "slotId":  "home.feed.beforeSections",
                                            "targets":  [
                                                            "tv",
                                                            "mobile",
                                                            "pc"
                                                        ],
                                            "render":  "slot_home_render",
                                            "onEvent":  "slot_home_onEvent",
                                            "priority":  0
                                        },
                                        {
                                            "id":  "hello_detail_actions",
                                            "title":  "Detail Hello",
                                            "slotId":  "detail.hero.actions",
                                            "targets":  [
                                                            "tv",
                                                            "mobile",
                                                            "pc"
                                                        ],
                                            "render":  "slot_detail_actions_render",
                                            "onEvent":  "slot_detail_actions_onEvent",
                                            "priority":  0
                                        },
                                        {
                                            "id":  "hello_player_actions",
                                            "title":  "Player Hello",
                                            "slotId":  "player.appbar.trailing",
                                            "targets":  [
                                                            "tv",
                                                            "mobile",
                                                            "pc"
                                                        ],
                                            "render":  "slot_player_appbar_render",
                                            "onEvent":  "slot_player_appbar_onEvent",
                                            "priority":  0
                                        }
                                    ]
                      }
}
