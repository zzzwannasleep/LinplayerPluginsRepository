{
    "schemaVersion":  1,
    "id":  "example.hello",
    "name":  "Open Website Example Plugin",
    "description":  "演示：openUrl 打开网站 + 最小网络请求",
    "version":  "1.0.0",
    "apiVersion":  1,
    "minHostVersion":  "1.0.0",
