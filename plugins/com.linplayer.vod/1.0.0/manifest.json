{
  "$schema": "../../../schemas/manifest.schema.json",
  "id": "com.linplayer.vod",
  "version": "1.0.0",
  "apiVersion": 2,
  "name": "VOD 资源站",
  "description": "填一个资源站的采集接口地址(形如 …/api.php/provide/vod/),就能按分类浏览:海报墙、剧集分集、多线路、搜索、点开就播。一个站配一个服务器,想加几个加几个。",
  "author": "LinPlayer",
  "category": "source",
  "targets": ["pc", "mobile"],
  "icon": "icon.svg",
  "license": "MIT",
  "tags": ["影视", "资源站", "采集", "vod", "数据源"],
  "homepage": "https://github.com/zzzwannasleep/LinplayerPluginsRepository",
  "permissions": ["sources", "http"],
  "httpAllowedHosts": ["$sourceServer"],
  "contributes": {
    "dataSources": [
      {
        "id": "site",
        "name": "VOD 资源站",
        "auth": {
          "fields": [
            {
              "id": "base_url",
              "label": "采集接口地址",
              "type": "url",
              "required": true,
              "placeholder": "https://example.com/api.php/provide/vod/"
            }
          ]
        }
      }
    ]
  }
}
