{
  "id": "com.linplayer.cf-proxy",
  "version": "1.0.0",
  "name": "CF 优选反代",
  "author": "LinPlayer",
  "description": "为走 Cloudflare 的服务器线路，从本地实测挑出最快的 CF 边缘 IP 并启用本地反代改写线路；比公共优选 IP 更贴合你的网络。支持定时测速，全天候保速。",
  "main": "main.js",
  "icon": "icon.svg",
  "homepage": "https://github.com/zzzwannasleep/LinplayerPluginsRepository",
  "tags": ["cloudflare", "优选", "反代", "加速", "network"],
  "targets": ["pc", "mobile", "tv"],
  "channel": "stable",
  "apiVersion": 1,
  "minHostVersion": "1.0.0",
  "permissions": ["cfproxy", "ui", "extensions"],
  "extends": {
    "settingsPages": [
      { "id": "panel", "title": "CF 优选反代", "handler": "openPanel" }
    ],
    "sidebarItems": [
      { "id": "panel", "title": "CF 优选反代", "icon": "bolt", "handler": "openPanel" }
    ]
  }
}
