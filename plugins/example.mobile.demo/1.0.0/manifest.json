{
    "schemaVersion":  1,
    "id":  "example.mobile.demo",
    "name":  "Mobile Demo Plugin",
    "description":  "演示：移动端页面 + slots（Home/Detail）",
    "version":  "1.0.0",
    "apiVersion":  1,
    "minHostVersion":  "0.0.1",
    "author":  {
                   "name":  "Example"
               },
    "targets":  [
                    "mobile"
                ],
    "entry":  {
                  "mobile":  {
                                 "script":  "main.js"
                             }
              },
    "permissions":  {
                        "network":  {
                                        "enabled":  false,
                                        "domains":  [
                                                        "*"
                                                    ]
                                    }
                    },
    "files":  [
                  {
                      "path":  "icon.svg",
                      "size":  303,
                      "sha256":  "3e7bbf775bef4b7d557d14ba7ecbab437cc478bf3d0484233d5dd23483518f0c"
                  },
                  {
                      "path":  "main.js",
                      "size":  2589,
                      "sha256":  "42037fe2e71128fea4de4a3ec1170f4a7b9203de310b112f772329017e9f9aa0"
                  }
              ],
    "contributions":  {
                          "pages":  [
                                        {
                                            "id":  "home",
                                            "title":  "Mobile Demo",
                                            "route":  "/plugin/example.mobile.demo/home",
                                            "targets":  [
                                                            "mobile"
                                                        ],
                                            "render":  "page_home_render",
                                            "onEvent":  "page_home_onEvent",
                                            "icon":  "icon.svg",
                                            "order":  0,
                                            "entry":  true
                                        }
                                    ],
                          "slots":  [
                                        {
                                            "id":  "mobile_home_after",
                                            "title":  "Mobile Home Slot",
                                            "slotId":  "home.feed.afterSections",
                                            "targets":  [
                                                            "mobile"
                                                        ],
                                            "render":  "slot_home_after_render",
                                            "onEvent":  "slot_home_after_onEvent",
                                            "priority":  0
                                        },
                                        {
                                            "id":  "mobile_detail_actions",
                                            "title":  "Mobile Detail Actions",
                                            "slotId":  "detail.hero.actions",
                                            "targets":  [
                                                            "mobile"
                                                        ],
                                            "render":  "slot_detail_actions_render",
                                            "onEvent":  "slot_detail_actions_onEvent",
                                            "priority":  0
                                        }
                                    ]
                      }
}
