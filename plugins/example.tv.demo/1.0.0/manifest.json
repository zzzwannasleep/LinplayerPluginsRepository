{
    "schemaVersion":  1,
    "id":  "example.tv.demo",
    "name":  "TV Demo Plugin",
    "description":  "演示：TV 端 Focus + slots（Home/Player）",
    "version":  "1.0.0",
    "apiVersion":  1,
    "minHostVersion":  "0.0.1",
    "author":  {
                   "name":  "Example"
               },
    "targets":  [
                    "tv"
                ],
    "entry":  {
                  "tv":  {
                             "script":  "main.js"
                         }
              },
    "permissions":  {
                        "network":  {
                                        "enabled":  false
                                    }
                    },
    "files":  [
                  {
                      "path":  "icon.svg",
                      "size":  302,
                      "sha256":  "84aaac27b856942d86f1e9134e43c706f77e0cea4276e8299c88b675d92c83c4"
                  },
                  {
                      "path":  "main.js",
                      "size":  3653,
                      "sha256":  "27b95d0698e270ce7baf8ccc74b8a4d1d62f67f4178cb00eb8f1fb00421138dc"
                  }
              ],
    "contributions":  {
                          "pages":  [
                                        {
                                            "id":  "home",
                                            "title":  "TV Demo",
                                            "route":  "/plugin/example.tv.demo/home",
                                            "targets":  [
                                                            "tv"
                                                        ],
                                            "render":  "page_home_render",
                                            "onEvent":  "page_home_onEvent",
                                            "icon":  "icon.svg",
                                            "order":  0,
                                            "entry":  true
                                        }
                                    ],
                          "slots":  [
                                        {
                                            "id":  "tv_home",
                                            "title":  "TV Home Slot",
                                            "slotId":  "home.feed.beforeSections",
                                            "targets":  [
                                                            "tv"
                                                        ],
                                            "render":  "slot_home_render",
                                            "onEvent":  "slot_home_onEvent",
                                            "priority":  0
                                        },
                                        {
                                            "id":  "tv_player_actions",
                                            "title":  "TV Player Actions",
                                            "slotId":  "player.appbar.trailing",
                                            "targets":  [
                                                            "tv"
                                                        ],
                                            "render":  "slot_player_appbar_render",
                                            "onEvent":  "slot_player_appbar_onEvent",
                                            "priority":  0
                                        }
                                    ]
                      }
}
