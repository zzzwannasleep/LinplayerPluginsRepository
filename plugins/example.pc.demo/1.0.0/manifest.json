{
    "schemaVersion":  1,
    "id":  "example.pc.demo",
    "name":  "PC Demo Plugin",
    "description":  "演示：PC 端双栏布局 + slots（Detail/Player）",
    "version":  "1.0.0",
    "apiVersion":  1,
    "minHostVersion":  "0.0.1",
    "author":  {
                   "name":  "Example"
               },
    "targets":  [
                    "pc"
                ],
    "entry":  {
                  "pc":  {
                             "script":  "main.js"
                         }
              },
    "permissions":  {
                        "network":  {
                                        "enabled":  false,
                                        "domains":  [
                                                        "*"
                                                    ]
                                    }
                    },
    "files":  [
                  {
                      "path":  "icon.svg",
                      "size":  302,
                      "sha256":  "6149e54d084faca8df03a0fe075036114fd6537eeacf7b7f32c4410d84ae9bdd"
                  },
                  {
                      "path":  "main.js",
                      "size":  3111,
                      "sha256":  "cc076f6473eebfa30a8f9a9bfb1d6713a23a8be3907c123a6f090c1012fdfcaf"
                  }
              ],
    "contributions":  {
                          "pages":  [
                                        {
                                            "id":  "home",
                                            "title":  "PC Demo",
                                            "route":  "/plugin/example.pc.demo/home",
                                            "targets":  [
                                                            "pc"
                                                        ],
                                            "render":  "page_home_render",
                                            "onEvent":  "page_home_onEvent",
                                            "icon":  "icon.svg",
                                            "order":  0,
                                            "entry":  true
                                        }
                                    ],
                          "slots":  [
                                        {
                                            "id":  "pc_detail_bottom",
                                            "title":  "PC Detail Bottom",
                                            "slotId":  "detail.sections.bottom",
                                            "targets":  [
                                                            "pc"
                                                        ],
                                            "render":  "slot_detail_bottom_render",
                                            "onEvent":  "slot_detail_bottom_onEvent",
                                            "priority":  0
                                        },
                                        {
                                            "id":  "pc_player_actions",
                                            "title":  "PC Player Actions",
                                            "slotId":  "player.appbar.trailing",
                                            "targets":  [
                                                            "pc"
                                                        ],
                                            "render":  "slot_player_appbar_render",
                                            "onEvent":  "slot_player_appbar_onEvent",
                                            "priority":  0
                                        }
                                    ]
                      }
}
