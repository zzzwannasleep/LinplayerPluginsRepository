{
  "id": "com.linplayer.uhdnow-traffic-ios",
  "version": "1.0.0",
  "name": "UHDNow 流量统计 (iOS)",
  "author": "LinPlayer",
  "description": "iOS 数据驱动版：登录 uhdnow 换 token → 拉流量 → 算剩余，全部在设备上由 App 内置解释器执行。无可执行代码、无远端服务器，App Store 合规。当服务器地址含 uhdnow 时在首页显示。请在插件设置里填 uhdnow 网站账号密码。",
  "minAppVersion": "1.1.0",
  "tags": ["uhdnow", "traffic", "homeStats", "ios"],
  "targets": ["ios"],
  "runtime": "data",
  "channel": "stable",
  "apiVersion": 1,
  "minHostVersion": "1.1.0",
  "permissions": ["http", "emby.read"],
  "httpAllowedHosts": ["www.uhdnow.com"],
  "data": {
    "settings": [
      { "key": "username", "label": "网站用户名", "type": "text", "hint": "uhdnow 网站登录账号（可能与 Emby 不同）" },
      { "key": "password", "label": "网站密码", "type": "password" }
    ],
    "homeStats": {
      "when": { "serverUrlIncludes": "uhdnow" },
      "steps": [
        {
          "request": {
            "method": "POST",
            "url": "https://www.uhdnow.com/api/v1/auth/login",
            "json": { "username": "{cfg.username}", "password": "{cfg.password}" }
          },
          "capture": { "token": "data.token" }
        },
        {
          "request": {
            "method": "GET",
            "url": "https://www.uhdnow.com/api/v1/traffic/me",
            "headers": { "Authorization": "{token}" }
          },
          "capture": { "used": "data.used_bytes", "limit": "data.limit_bytes" }
        }
      ],
      "metrics": [
        { "label": "剩余流量", "value": { "subtract": ["limit", "used"], "divide": 1073741824, "round": 1, "suffix": " GB" } },
        { "label": "总流量", "value": { "var": "limit", "divide": 1073741824, "round": 0, "suffix": " GB" } }
      ]
    }
  }
}
